+// NotifyStoredArchivedChats reports all chats marked archived in the app state
+// store, including those without messages in the history sync, so they can be
+// listed in the archived chats view.
+func NotifyStoredArchivedChats(connId int) {
+	client := GetClient(connId)
+	if client == nil || client.Store.ID == nil {
+		return
+	}
+
+	db, err := sql.Open("sqlite3", fmt.Sprintf("file:%s?mode=ro", GetPath(connId)+"/session.db"))
+	if err != nil {
+		LOG_WARNING(fmt.Sprintf("archived chats db error %#v", err))
+		return
+	}
+	defer db.Close()
+
+	rows, err := db.Query("SELECT chat_jid FROM whatsmeow_chat_settings WHERE our_jid=? AND archived=1",
+		client.Store.ID.String())
+	if err != nil {
+		LOG_WARNING(fmt.Sprintf("archived chats query error %#v", err))
+		return
+	}
+	defer rows.Close()
+
+	count := 0
+	for rows.Next() {
+		var jidStr string
+		if rows.Scan(&jidStr) != nil {
+			continue
+		}
+		jid, parseErr := types.ParseJID(jidStr)
+		if parseErr != nil {
+			continue
+		}
+		chatId := GetChatId(client, &jid, nil)
+		CWmUpdateArchivedNotify(connId, chatId, 1)
+		count++
+	}
+	LOG_INFO(fmt.Sprintf("archived chats from store: %d", count))
+}
