+// Short help screen from guide.txt in the application dir, any key closes it
+void UiModel::OnKeyGuide()
+{
+  std::string text = FileUtil::ReadFile(FileUtil::GetApplicationDir() + "/guide.txt");
+  if (text.empty())
+  {
+    text = "guide.txt not found";
+  }
+
+  while (!text.empty() && (text.back() == '\n'))
+  {
+    text.pop_back();
+  }
+
+  const int lines = (int)std::count(text.begin(), text.end(), '\n') + 1;
+  UiDialogParams params(this, "", 0.95f, (float)(lines + 2));
+  UiMessageDialog messageDialog(params, text, true /*p_Guide*/);
+  messageDialog.Run();
+  ReinitView();
+}
