+// Stops what attachment_open_command started in the background (e.g. audio playback)
+void UiModel::Impl::OnKeyStop()
+{
+  AnyUserKeyInput();
+
+  static const std::string stopCommand = UiConfig::GetStr("attachment_stop_command");
+  if (stopCommand.empty()) return;
+
+  RunProgram(stopCommand);
+}
