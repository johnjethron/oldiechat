+// Display filter for terminals with limited font coverage or outdated character width
+// tables (e.g. Android 4.x terminal apps). Driven by glyphs.txt in the application dir:
+//   A <hex>[-<hex>]  code points the terminal renders, with matching width
+//   R <hex> <text>   replacement for a code point (text may be empty)
+//   E <text>         fallback for other emoji / pictographs
+//   O <text>         fallback for other unsupported code points
+// Without glyphs.txt the string is returned unchanged.
+struct GlyphTable
+{
+  bool loaded = false;
+  std::vector<std::pair<uint32_t, uint32_t>> allowed;
+  std::unordered_map<uint32_t, std::string> replacements;
+  std::string emojiFallback = "[e]";
+  std::string otherFallback = "?";
+};
+
+static const GlyphTable& GetGlyphTable()
+{
+  static GlyphTable table;
+  static std::once_flag once;
+  std::call_once(once, []()
+  {
+    std::ifstream stream(FileUtil::GetApplicationDir() + "/glyphs.txt");
+    if (!stream) return;
+
+    std::string line;
+    while (std::getline(stream, line))
+    {
+      if (line.size() < 2 || line[1] != ' ') continue;
+
+      const char type = line[0];
+      const std::string arg = line.substr(2);
+      if (type == 'A')
+      {
+        const size_t dash = arg.find('-');
+        const uint32_t first = std::stoul(arg.substr(0, dash), nullptr, 16);
+        const uint32_t last = (dash == std::string::npos) ? first : std::stoul(arg.substr(dash + 1), nullptr, 16);
+        table.allowed.push_back(std::make_pair(first, last));
+      }
+      else if (type == 'R')
+      {
+        const size_t space = arg.find(' ');
+        const uint32_t cp = std::stoul(arg.substr(0, space), nullptr, 16);
+        table.replacements[cp] = (space == std::string::npos) ? "" : arg.substr(space + 1);
+      }
+      else if (type == 'E')
+      {
+        table.emojiFallback = arg;
+      }
+      else if (type == 'O')
+      {
+        table.otherFallback = arg;
+      }
+    }
+
+    std::sort(table.allowed.begin(), table.allowed.end());
+    table.loaded = true;
+    LOG_INFO("glyph filter loaded %zu ranges %zu replacements", table.allowed.size(), table.replacements.size());
+  });
+
+  return table;
+}
+
+std::string StrUtil::GlyphFilter(const std::string& p_Str)
+{
+  const GlyphTable& table = GetGlyphTable();
+  if (!table.loaded) return p_Str;
+
+  const std::wstring wstr = ToWString(p_Str);
+  std::wstring out;
+  out.reserve(wstr.size());
+  for (wchar_t wc : wstr)
+  {
+    const uint32_t cp = static_cast<uint32_t>(wc);
+    if (cp < 0xA0)
+    {
+      out.push_back(wc);
+      continue;
+    }
+
+    auto it = std::upper_bound(table.allowed.begin(), table.allowed.end(), std::make_pair(cp, UINT32_MAX));
+    if ((it != table.allowed.begin()) && (cp <= std::prev(it)->second))
+    {
+      out.push_back(wc);
+      continue;
+    }
+
+    auto rit = table.replacements.find(cp);
+    if (rit != table.replacements.end())
+    {
+      out += ToWString(rit->second);
+    }
+    else if (((cp >= 0xFE00) && (cp <= 0xFE0F)) || ((cp >= 0x200B) && (cp <= 0x200F)) ||
+             ((cp >= 0x2060) && (cp <= 0x206F)) || ((cp >= 0x1F3FB) && (cp <= 0x1F3FF)) ||
+             ((cp >= 0xE0000) && (cp <= 0xE007F)) || (cp == 0x20E3))
+    {
+      // zero-width joiners, variation selectors, skin tone modifiers, tags, keycap
+    }
+    else if ((cp >= 0x1F1E6) && (cp <= 0x1F1FF))
+    {
+      // regional indicators (flags) as country code letters
+      out.push_back(L'A' + (cp - 0x1F1E6));
+    }
+    else if (((cp >= 0x1F000) && (cp <= 0x1FAFF)) || ((cp >= 0x2600) && (cp <= 0x27BF)) ||
+             ((cp >= 0x2B00) && (cp <= 0x2BFF)))
+    {
+      out += ToWString(table.emojiFallback);
+    }
+    else
+    {
+      out += ToWString(table.otherFallback);
+    }
+  }
+
+  return ToString(out);
+}
