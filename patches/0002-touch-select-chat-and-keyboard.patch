+int UiListView::GetChatIndexAt(int p_ScreenX, int p_ScreenY)
+{
+  if (!m_Enabled || (m_PaddedWin == nullptr)) return -1;
+
+  int row = p_ScreenY - (m_Y + 1);
+  int col = p_ScreenX - (m_X + 1);
+  if ((row < 0) || (row >= m_PaddedH) || (col < 0) || (col >= m_PaddedW)) return -1;
+
+  int index = m_Offset + row;
+  return (index < m_Count) ? index : -1;
+}
