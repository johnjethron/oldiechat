+void UiModel::Impl::OnKeyMouse()
+{
+  MEVENT event;
+  if (getmouse(&event) != OK) return;
+
+  if (!(event.bstate & (BUTTON1_PRESSED | BUTTON1_CLICKED))) return;
+
+  AnyUserKeyInput();
+
+  if (m_View->IsEntryAt(event.x, event.y))
+  {
+    // Terminals such as TermOne Plus only toggle the soft keyboard on tap when
+    // mouse tracking is off, so disable it briefly to let the next tap through.
+    mousemask(0, nullptr);
+    doupdate();
+    m_MouseResumeTimeMs = TimeUtil::GetCurrentTimeMSec() + 3000;
+    return;
+  }
+
+  if (GetEditMessageActive()) return;
+
+  int index = m_View->GetListChatIndexAt(event.x, event.y);
+  if ((index < 0) || (index >= (int)m_ChatVec.size()) || (index == m_CurrentChatIndex)) return;
+
+  m_CurrentChatIndex = index;
+  m_CurrentChat = m_ChatVec.at(m_CurrentChatIndex);
+  OnCurrentChatChanged();
+  SetSelectMessageActive(false);
+}
