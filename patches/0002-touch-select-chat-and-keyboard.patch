+
+bool UiView::IsEntryAt(int p_ScreenX, int p_ScreenY)
+{
+  if (!m_UiEntryView) return false;
+
+  return (p_ScreenY >= m_UiEntryView->Y()) && (p_ScreenY < (m_UiEntryView->Y() + m_UiEntryView->H())) &&
+         (p_ScreenX >= m_UiEntryView->X()) && (p_ScreenX < (m_UiEntryView->X() + m_UiEntryView->W()));
+}
