+void UiModel::Impl::OnKeyToggleArchived()
+{
+  AnyUserKeyInput();
+
+  if (GetEditMessageActive()) return;
+
+  SetShowArchived(!m_ShowArchived);
+}
+
+// The chat list shows either the regular chats or (only) the archived chats
+void UiModel::Impl::SetShowArchived(bool p_ShowArchived)
+{
+  if (m_ShowArchived == p_ShowArchived) return;
+
+  m_ShowArchived = p_ShowArchived;
+  m_ChatVec.clear();
+  m_ChatSet.clear();
+  for (auto& profileChatInfos : m_ChatInfos)
+  {
+    const std::string& profileId = profileChatInfos.first;
+    for (auto& chatInfoPair : profileChatInfos.second)
+    {
+      const ChatInfo& chatInfo = chatInfoPair.second;
+      if (IsChatForceHidden(chatInfo.id) || (chatInfo.isArchived != m_ShowArchived)) continue;
+
+      if (m_ChatSet[profileId].insert(chatInfo.id).second)
+      {
+        m_ChatVec.push_back(std::make_pair(profileId, chatInfo.id));
+      }
+    }
+  }
+
+  SortChats();
+  m_CurrentChatIndex = 0;
+  m_CurrentChat = m_ChatVec.empty() ? s_ChatNone : m_ChatVec.at(0);
+  OnCurrentChatChanged();
+  SetSelectMessageActive(false);
+  UpdateList();
+  UpdateStatus();
+}
+
+bool UiModel::Impl::GetShowArchived()
+{
+  return m_ShowArchived;
+}
