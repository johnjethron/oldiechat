+// Duration in seconds of an Ogg file, from the granule position of its last
+// page (48 kHz for Opus), or -1
+static int OggDurationSec(const std::string& p_Path)
+{
+  std::ifstream file(p_Path, std::ios::binary | std::ios::ate);
+  if (!file) return -1;
+
+  const std::streamoff size = file.tellg();
+  const std::streamoff len = std::min<std::streamoff>(size, 65536);
+  std::string tail(len, '\0');
+  file.seekg(size - len);
+  file.read(&tail[0], len);
+
+  const size_t pos = tail.rfind("OggS");
+  if ((pos == std::string::npos) || ((pos + 14) > tail.size())) return -1;
+
+  int64_t granule = 0;
+  for (int i = 7; i >= 0; --i)
+  {
+    granule = (granule << 8) | (unsigned char)tail[pos + 6 + i];
+  }
+
+  return (granule > 0) ? (int)(granule / 48000) : -1;
+}
+
+// Attachment name shown in the history: one short word, and voice notes as
+// "audio mm.ss", with the duration from the file name (<id>.<secs>s.oga) or
+// from the downloaded file
+static std::string AttachmentName(const std::string& p_FilePath)
+{
+  static const std::regex audioExt("\\.(oga|ogg|opus|mp3|m4a|aac|amr|wav)$", std::regex::icase);
+  static const std::regex imageExt("\\.(jpe?g|png|gif|heic)$", std::regex::icase);
+  static const std::regex videoExt("\\.(mp4|3gp|mov|mkv|webm)$", std::regex::icase);
+  static const std::regex stickerExt("\\.webp$", std::regex::icase);
+  static const std::regex secsInName("\\.([0-9]+)s\\.[A-Za-z0-9]+$");
+  static std::unordered_map<std::string, int> durations;
+
+  const std::string name = FileUtil::BaseName(p_FilePath);
+  if (name.empty()) return name;
+  if (std::regex_search(name, imageExt)) return "imagen";
+  if (std::regex_search(name, videoExt)) return "video";
+  if (std::regex_search(name, stickerExt)) return "sticker";
+  if (!std::regex_search(name, audioExt)) return "documento";
+
+  auto it = durations.find(p_FilePath);
+  int secs = (it != durations.end()) ? it->second : -1;
+  if (secs < 0)
+  {
+    std::smatch match;
+    if (std::regex_search(name, match, secsInName))
+    {
+      secs = std::stoi(match[1].str());
+    }
+    else
+    {
+      secs = OggDurationSec(p_FilePath);
+    }
+
+    if (secs >= 0)
+    {
+      durations[p_FilePath] = secs;
+    }
+  }
+
+  if (secs < 0) return "audio";
+
+  char label[32];
+  snprintf(label, sizeof(label), "audio %02d.%02d", secs / 60, secs % 60);
+  return label;
+}
