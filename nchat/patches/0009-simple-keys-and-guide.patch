+// Text screen that any key closes; returns true if closed with the back key
+bool UiModel::TextDialog(const std::string& p_Text)
+{
+  std::string text = p_Text;
+  while (!text.empty() && (text.back() == '\n'))
+  {
+    text.pop_back();
+  }
+
+  // same width and wrapping as UiMessageDialog: border (2) + padding (2), top margin
+  const int w = (int)(GetScreenWidth() * 0.95f);
+  const int lines = (int)StrUtil::WordWrap(StrUtil::ToWString(text), std::max(1, w - 4), false, false, false, 2).size();
+  UiDialogParams params(this, "", 0.95f, (float)(lines + 3));
+  UiMessageDialog messageDialog(params, text, true /*p_Guide*/);
+  bool rv = messageDialog.Run();
+  ReinitView();
+  return rv;
+}
+
+// Short help screen from guide.txt in the application dir
+void UiModel::OnKeyGuide()
+{
+  std::string text = FileUtil::ReadFile(FileUtil::GetApplicationDir() + "/guide.txt");
+  TextDialog(text.empty() ? "guide.txt not found" : text);
+}
+
+// Back: goes back one step; from the main list it quits (after confirmation)
+void UiModel::OnKeyBack()
+{
+  {
+    std::unique_lock<owned_mutex> lock(m_ModelMutex);
+    if (GetImpl().OnKeyBack()) return;
+  }
+
+  static const bool confirmQuit = UiConfig::GetBool("back_confirm_quit");
+  if (confirmQuit)
+  {
+    std::string text = UiConfig::GetStr("back_quit_text");
+    StrUtil::ReplaceString(text, "\\n", "\n");
+    if (!TextDialog(text)) return;
+  }
+
+  OnKeyQuit();
+}
