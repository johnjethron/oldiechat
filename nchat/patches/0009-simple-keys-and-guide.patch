+bool UiModel::Impl::IsEntryEmpty()
+{
+  return m_EntryStr[m_CurrentChat.first][m_CurrentChat.second].empty();
+}
+
+void UiModel::Impl::OnKeySwitchChat(bool p_Next)
+{
+  if (GetSelectMessageActive())
+  {
+    m_MessageOffset[m_CurrentChat.first][m_CurrentChat.second] = 0;
+    SetSelectMessageActive(false);
+  }
+
+  p_Next ? OnKeyNextChat() : OnKeyPrevChat();
+}
+
+// Enter on a selected message: open its attachment (e.g. play a voice note), or
+// go back to writing if it has none.
+void UiModel::Impl::OnKeyEnterSelected()
+{
+  const std::string& profileId = m_CurrentChat.first;
+  const std::string& chatId = m_CurrentChat.second;
+  const std::vector<std::string>& messageVec = m_MessageVec[profileId][chatId];
+  const int messageOffset = m_MessageOffset[profileId][chatId];
+  const std::unordered_map<std::string, ChatMessage>& messages = m_Messages[profileId][chatId];
+
+  bool hasAttachment = false;
+  if ((messageOffset >= 0) && (messageOffset < (int)messageVec.size()))
+  {
+    auto mit = messages.find(messageVec.at(messageOffset));
+    hasAttachment = (mit != messages.end()) && !mit->second.fileInfo.empty();
+  }
+
+  if (hasAttachment)
+  {
+    OnKeyOpenAttachment();
+  }
+  else
+  {
+    AnyUserKeyInput();
+    m_MessageOffset[profileId][chatId] = 0;
+    SetSelectMessageActive(false);
+    UpdateHistory();
+  }
+}
+
+// Back: leave message selection, then the archived list. Returns false when
+// there is nothing to go back from (the caller then quits).
+bool UiModel::Impl::OnKeyBack()
+{
+  AnyUserKeyInput();
+
+  if (GetEditMessageActive()) return true;
+
+  if (GetSelectMessageActive())
+  {
+    m_MessageOffset[m_CurrentChat.first][m_CurrentChat.second] = 0;
+    SetSelectMessageActive(false);
+    UpdateHistory();
+    return true;
+  }
+
+  if (m_ShowArchived)
+  {
+    SetShowArchived(false);
+    return true;
+  }
+
+  return false;
+}
