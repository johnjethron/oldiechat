+// Character widths as the terminal draws them (W lines of glyphs.txt, measured on
+// the phone). Replaces the C library wcwidth() in this static build, so nchat and
+// ncurses position text exactly like the terminal. Code points not listed are 1
+// column wide, except planes 1-3 without glyphs.txt.
+extern "C" int wcwidth(wchar_t p_Wc)
+{
+  const uint32_t cp = static_cast<uint32_t>(p_Wc);
+  if (cp == 0) return 0;
+  if ((cp < 0x20) || ((cp >= 0x7F) && (cp < 0xA0))) return -1;
+  if (cp < 0x7F) return 1;
+
+  const GlyphTable& table = GetGlyphTable();
+  if (table.loaded)
+  {
+    auto it = std::upper_bound(table.widths.begin(), table.widths.end(),
+                               std::make_pair(std::make_pair(cp, UINT32_MAX), INT_MAX));
+    if ((it != table.widths.begin()) && (cp <= std::prev(it)->first.second))
+    {
+      return std::prev(it)->second;
+    }
+
+    return 1;
+  }
+
+  const uint32_t plane = cp >> 16;
+  return ((plane >= 1) && (plane <= 3)) ? 2 : 1;
+}
