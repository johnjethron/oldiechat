# versions.env - versiones exactas de todo lo que se descarga para compilar.
#
# Es el único lugar donde se cambian versiones. build.sh y los scripts lo leen.
# Al subir una versión, actualiza también su checksum (sha256sum del archivo).

# Imagen base de compilación (Alpine armv7, musl). Fijada por digest.
ALPINE_IMAGE=alpine:3.24.3@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a

# Go oficial, parcheado con Go PR #69325 (el parche viene en nchat y es para esta versión).
GO_VERSION=1.26.3
GO_SHA256=d44133d4c66b1451a1e247da26db7716f76a081c0169a75e6c84e1871e394320

# nchat (incluye whatsmeow en lib/wmchat/go/ext/whatsmeow).
NCHAT_REPO=https://github.com/d99kris/nchat
NCHAT_COMMIT=91908dfab06356584cc594cd589a33d4a5dc19b3

# whatsmeow incluido en ese commit de nchat (informativo: lo fija NCHAT_COMMIT).
WHATSMEOW_VERSION=20261016
WHATSMEOW_COMMIT=0b0a1cd

# libopus (decodificación de notas de voz).
OPUS_VERSION=1.5.2
OPUS_SHA256=65c1d2f78b9f2fb20082c38cbe47c951ad5839345876e46941612ee87f9a7ce1

# Reproductor Java: d8 (r8) de Google y JDK para compilar.
R8_VERSION=8.5.35
R8_SHA256=4733945987ee0a840fafc34080b135259e01678412e07212b23f706334290294
JDK_IMAGE=eclipse-temurin:17-jdk@sha256:fe947d993c32dd9cf651a4353a6ed723c2370b3a9d034ea4cab4775404ea531a
